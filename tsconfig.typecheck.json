{
  "extends": "./jsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "maxNodeModuleJsDepth": 1,
    "ignoreDeprecations": "5.0",
    "noImplicitAny": false,
    "skipLibCheck": true,
    "noImplicitReturns": false,
    "noImplicitThis": false
  },
  "include": [
    "src/vite-env.d.ts",
    "src/lib/optimistic/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "**/*.test.js", "**/*.test.jsx", "**/*.test.ts", "**/*.test.tsx"]
}
