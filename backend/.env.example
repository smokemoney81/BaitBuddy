# Supabase-Konfiguration (ERFORDERLICH für Datenbank)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic Claude API (ERFORDERLICH für KI-Funktionen: Chat & Bildanalyse)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
# Optional: Modell überschreiben (Default claude-haiku-4-5). Für höhere Qualität
# z. B. claude-opus-4-8.
# ANTHROPIC_MODEL=claude-haiku-4-5

# Optional: ElevenLabs TTS (für Sprachausgabe)
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_VOICE_ID=onwK4e9ZLuTAKqWW03F9
# Weibliche Stimme "Matilda" (nur Ultimate). Optional; Default siehe ai.js.
# ELEVENLABS_VOICE_ID_FEMALE=XrExE9yKIg1WjnnlVkGX
# Schnelles Modell + kompaktes Format (Default eleven_flash_v2_5). Fuer hoehere
# Qualitaet umschaltbar.
# ELEVENLABS_MODEL_ID=eleven_flash_v2_5
# ELEVENLABS_OUTPUT_FORMAT=mp3_44100_64

# Optional: OpenAI Realtime (Voice-Modus). Ohne Key ist der Live-Voice-Modus aus.
# OPENAI_API_KEY=sk-your-openai-key
# OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview
# OPENAI_REALTIME_VOICE=alloy

# Optional: Google Gemini / Google Cloud (Zusatz-TTS/Analyse, falls konfiguriert).
# GEMINI_API_KEY=your-gemini-key
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
# GOOGLE_CLOUD_API_KEY=your-google-cloud-key

# Admin-Zugriff (kommagetrennte E-Mail-Allowlist, z.B. fuer /api/maps/*)
ADMIN_EMAILS=admin@baitbuddy.app

# ERFORDERLICH: Secret fuer die taeglichen Cron-Endpunkte (/api/admin/*). Ohne
# diesen Wert verweigern die Admin-Routen den Start. Der Cloudflare-Cron-Worker,
# der Docker-Cron und (frueher) Vercel senden es als "Authorization: Bearer".
CRON_SECRET=change-me-long-random-secret

# Optional: Kaufverifikation fuer /premium/activate (ohne diese Werte
# bleibt Premium-Aktivierung mit 501 gesperrt statt ungeprueft freizuschalten).
# STRIPE_SECRET_KEY schaltet zusaetzlich den Web-Checkout /premium/checkout frei.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON={"type":"service_account","...":"..."}
STRIPE_SECRET_KEY=sk_live_your-stripe-secret-key
# Stripe endpoint signing secret (whsec_...). Set only as a server/Worker secret.
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-signing-secret

# Optional: Basis-URL fuer Stripe-Redirects (success/cancel). Ohne diesen Wert
# wird der Origin des Checkout-Requests verwendet.
APP_BASE_URL=https://app.baitbuddy.example
# Optional: oeffentliche App-URL (Referral-/Redirect-Links). Wird – wie
# APP_BASE_URL – automatisch in die CORS-Allowlist aufgenommen.
# APP_URL=https://app.baitbuddy.example

# Erlaubte Web-Origins (Komma-Liste). Gesetzt ersetzt sie die Defaults komplett;
# nach dem Cloudflare-Umzug hier die neue Domain eintragen.
# ALLOWED_ORIGINS=https://app.baitbuddy.example,capacitor://localhost

# Optional: Rate-Limit-Store (instanzuebergreifend). Vercel KV / Upstash / Redis
# (ioredis-kompatibel). Ohne Wert faellt es auf einen In-Memory-Store zurueck.
# KV_URL=redis://default:password@host:6379
# REDIS_URL=redis://localhost:6379

# Optional: Sperrt Karten-Download/-Verwaltung (read-only FS). Auf Vercel
# automatisch aktiv; auf einem Container mit beschreibbarem Volume via 0 erlaubt.
# READ_ONLY_FS=0

# Optional: Sentry Fehler-Monitoring.
# SENTRY_DSN=https://your-dsn@o0.ingest.sentry.io/0
# LOG_LEVEL=info

# Server-Port
PORT=3000

# Umgebung
NODE_ENV=development

# Email-Konfiguration (für Support-Tickets)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SUPPORT_EMAIL=kaisaschnitt99@gmail.com
# Optional: Empfaenger fuer Entwickler-/Fehlerbenachrichtigungen.
# DEVELOPER_EMAIL=kaisaschnitt99@gmail.com
