# BaitBuddy Backend — Konfiguration
#
# Für Cloudflare: Diese Secrets werden als Worker Secrets oder Container
# Environment Variables gesetzt (nicht in .env vor Ort, sondern im Dashboard
# oder via `wrangler secret put` / Container-Umgebung).
#
# Pflichtwerte stehen unten, alles darunter ist optional und hat einen im Code
# hinterlegten Default. Jede hier gelistete Variable wird auch tatsächlich
# gelesen; die Fundstelle steht jeweils dabei.

# ─── Pflicht ──────────────────────────────────────────────────────────────────

# Supabase (backend/src/lib/supabase.js). Ohne diese Werte kommt keine
# Datenbank-Anfrage durch.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# KI-Anbieter (backend/src/lib/llm.js). Der erste gesetzte Schlüssel antwortet,
# die übrigen springen nur bei einem Fehler ein:
#   Chat/Text:    OPENAI_API_KEY → ANTHROPIC_API_KEY
#   Bildanalyse:  GEMINI_API_KEY → OPENAI_API_KEY → ANTHROPIC_API_KEY
# Achtung: OPENAI_API_KEY schaltet zugleich /api/ai/tts auf die OpenAI-Stimme
# (siehe Abschnitt Sprachausgabe).
OPENAI_API_KEY=sk-your-openai-api-key
# Default gpt-4.1-mini (schnell, hält das Latenzziel < 2 s).
# OPENAI_MODEL=gpt-4.1-mini

# Google Gemini für die Bildanalyse (Google AI Studio → API-Schlüssel).
# Ersatzweise werden GOOGLE_API_KEY bzw. GOOGLE_GENERATIVE_AI_API_KEY gelesen.
GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL=gemini-2.5-flash

# Anthropic Claude — nur noch Reserve. Der Schlüssel wird tolerant gesucht:
# getAnthropicKey() akzeptiert auch abweichend benannte Variablen, sofern ihr
# Wert wie ein Anthropic-Key aussieht (sk-ant-…), etwa CLAUDE_API_KEY.
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
# ANTHROPIC_MODEL=claude-haiku-4-5

# ─── Server & Umgebung ────────────────────────────────────────────────────────

PORT=3000
NODE_ENV=development

# Erlaubte CORS-Origins, kommagetrennt (backend/src/server.js).
# Ohne Angabe gilt: http://localhost:5173, https://bait-buddy.vercel.app,
# capacitor://localhost — der WebView der gepackten App braucht den letzten.
# ALLOWED_ORIGINS=https://app.baitbuddy.example,capacitor://localhost

# Basis-URL für geteilte Links aus dem Fangbuch (backend/src/routes/socialMedia.js).
# Default: https://bait-buddy.vercel.app
# APP_URL=https://app.baitbuddy.example

# Setzt die Vercel-Plattform selbst — nicht von Hand eintragen. Der Code
# unterscheidet daran Serverless- von Server-Betrieb (server.js, routes/maps.js).
# VERCEL=1

# ─── Logging & Fehlererfassung ────────────────────────────────────────────────

# DEBUG | INFO | WARN | ERROR | CRITICAL (backend/src/lib/logger.js).
# Default: INFO in production, sonst DEBUG.
# LOG_LEVEL=INFO

# Sentry greift nur, wenn ein DSN gesetzt UND NODE_ENV=production ist.
# SENTRY_DSN=https://your-key@sentry.io/project-id
# SENTRY_TRACES_SAMPLE_RATE=0.1

# ─── Rate-Limiting ────────────────────────────────────────────────────────────

# Vercel KV / Upstash Redis als instanzübergreifender Zähler
# (backend/src/middleware/rateLimit.js). Ohne diese Werte fällt das Limit auf
# einen In-Memory-Store zurück — pro Instanz, für lokal und Tests ausreichend.
# Fällt der Store aus, blockiert das die App nicht (fail-open).
# KV_URL=redis://default:token@host:6379
# REDIS_URL=redis://localhost:6379

# ─── Sprachausgabe (TTS) ──────────────────────────────────────────────────────

# Reihenfolge der Provider-Kette (backend/src/lib/multiProviderTTS.js):
#   OPENAI_API_KEY → ELEVENLABS_API_KEY → GOOGLE_CLOUD_API_KEY → GEMINI_API_KEY
# Es gewinnt der erste gesetzte Schlüssel. Ist OPENAI_API_KEY gesetzt (etwa für
# die Realtime-Voice-Session weiter unten), spricht /api/ai/tts folglich mit
# einer OpenAI-Stimme. Das ist so gewollt (siehe CLAUDE.md).
# Wer die ElevenLabs-Stimme erzwingen will, lässt OPENAI_API_KEY leer.

ELEVENLABS_API_KEY=your-elevenlabs-api-key

# Männliche Standardstimme "Daniel" (alle Pläne).
ELEVENLABS_VOICE_ID=onwK4e9ZLuTAKqWW03F9
# Weibliche Stimme "Matilda" — serverseitig auf Ultimate begrenzt
# (backend/src/lib/planResolver.js). Ohne Ultimate fällt der Server still auf
# die Standardstimme zurück.
# ELEVENLABS_VOICE_ID_FEMALE=XrExE9yKIg1WjnnlVkGX

# Default eleven_flash_v2_5 (~75 ms Latenz, spricht Deutsch). Auf das
# Qualitätsmodell umstellbar, kostet Antwortzeit.
# ELEVENLABS_MODEL_ID=eleven_flash_v2_5
# ELEVENLABS_OUTPUT_FORMAT=mp3_22050_32

# Weitere TTS-Provider der Kette — nur setzen, wenn bewusst gewünscht.
# GOOGLE_CLOUD_API_KEY=your-google-cloud-api-key
# GEMINI_API_KEY steht oben (Bildanalyse) und reiht sich hier zuletzt ein.
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# ─── Voice-Session (optional) ─────────────────────────────────────────────────

# Für POST /api/ai/realtime-session (backend/src/routes/ai.js) — nutzt denselben
# OPENAI_API_KEY wie der Chat (oben).
# OPENAI_REALTIME_MODEL=gpt-realtime
# OPENAI_REALTIME_VOICE=verse

# ─── Kaufverifikation ─────────────────────────────────────────────────────────

# Ohne diese Werte antwortet /premium/activate mit 501, statt einen Plan
# ungeprüft freizuschalten. STRIPE_SECRET_KEY schaltet zusätzlich den
# Web-Checkout /premium/checkout frei.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON={"type":"service_account","...":"..."}
STRIPE_SECRET_KEY=sk_live_your-stripe-secret-key
# Stripe endpoint signing secret (whsec_...). Set only as a server/Worker secret.
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-signing-secret

# Basis-URL für die Stripe-Rücksprünge (success/cancel). Ohne diesen Wert wird
# der Origin des Checkout-Requests verwendet.
APP_BASE_URL=https://app.baitbuddy.example
# Optional: oeffentliche App-URL (Referral-/Redirect-Links). Wird – wie
# APP_BASE_URL – automatisch in die CORS-Allowlist aufgenommen.
# APP_URL=https://app.baitbuddy.example

# Erlaubte Web-Origins (Komma-Liste). Gesetzt ersetzt sie die Defaults komplett;
# nach dem Cloudflare-Umzug hier die neue Domain eintragen.
# ALLOWED_ORIGINS=https://app.baitbuddy.example,capacitor://localhost

# Optional: Rate-Limit-Store (instanzuebergreifend). Vercel KV / Upstash / Redis
# (ioredis-kompatibel). Ohne Wert faellt es auf einen In-Memory-Store zurueck.
# KV_URL=redis://default:password@host:6379
# REDIS_URL=redis://localhost:6379

# Optional: Sperrt Karten-Download/-Verwaltung (read-only FS). Auf Vercel
# automatisch aktiv; auf einem Container mit beschreibbarem Volume via 0 erlaubt.
# READ_ONLY_FS=0

# Optional: Sentry Fehler-Monitoring.
# SENTRY_DSN=https://your-dsn@o0.ingest.sentry.io/0
# LOG_LEVEL=info

# ─── Administration ───────────────────────────────────────────────────────────

# Kommagetrennte E-Mail-Allowlist für Admin-Endpunkte (z. B. /api/maps/*).
ADMIN_EMAILS=admin@baitbuddy.app

# Schützt die Cron-Endpunkte in backend/src/routes/events.js. Vercel Crons
# schicken den Wert als "Authorization: Bearer <CRON_SECRET>"; alternativ wird
# der Header x-api-key akzeptiert. ADMIN_API_KEY dient als Ausweichname.
# Fehlt beides, antworten die Endpunkte mit 500 statt ungeschützt zu laufen.
CRON_SECRET=your-cron-secret
# ADMIN_API_KEY=your-admin-api-key

# Aufbewahrung beendeter Events in Tagen, bevor sie per Soft-Delete aus der
# Liste verschwinden (routes/events.js). Default: 3.
# EVENT_AUTO_DELETE_DAYS=3

# ─── E-Mail (Support-Tickets) ─────────────────────────────────────────────────

# Fehlt eines dieser Felder, protokolliert das Backend eine Warnung und
# verschickt keine Mail — Tickets werden weiterhin gespeichert.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SUPPORT_EMAIL=kaisaschnitt99@gmail.com

# Empfänger der Ticket-Benachrichtigung (backend/src/routes/support.js).
DEVELOPER_EMAIL=entwickler@baitbuddy.example
