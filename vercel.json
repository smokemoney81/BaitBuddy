{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install --legacy-peer-deps && cd backend && npm install",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/[...path]" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/icons/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800" }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/admin/premium/check-expiry",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/admin/events/auto-archive",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/admin/rewards/auto-activate",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/admin/leaderboards/monthly/generate",
      "schedule": "0 0 1 * *"
    },
    {
      "path": "/api/admin/credits/billing-cycle",
      "schedule": "30 4 * * *"
    }
  ]
}
