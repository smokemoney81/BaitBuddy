# BaitBuddy Frontend (Vite) — Konfiguration
#
# Vite reicht nur Variablen mit dem Präfix VITE_ an den Client durch. Alles
# hier landet damit im ausgelieferten Bundle und ist öffentlich einsehbar —
# niemals ein Secret (Service-Role-Key, Stripe-Secret, LLM-Key) eintragen.
# Serverseitige Werte gehören nach backend/.env.

# ─── Pflicht ──────────────────────────────────────────────────────────────────

# Supabase-Projekt (src/api/supabaseClient.js). Fehlen die Werte, wirft der
# Client schon beim Modul-Import. Der anon-Key ist für den Browser gedacht und
# öffentlich; geschützt wird die Datenbank durch die RLS-Policies, nicht durch
# Geheimhaltung dieses Werts.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anonymous-key

# ─── Optional ─────────────────────────────────────────────────────────────────

# Basis-URL des Backends (src/api/frontendClient.js). Leer lassen für
# gleichnamigen Ursprung — auf Vercel liegen Frontend und API unter derselben
# Domain, dort ist die Variable unnötig. Nur setzen, wenn das Backend
# woanders läuft (getrenntes Deployment, lokal gegen Remote-API).
# VITE_API_URL=https://api.baitbuddy.example

# Öffentliche App-URL für Auth-Redirects bei OAuth und Passwort-Reset
# (src/lib/publicUrl.js). Ohne Angabe wird window.location.origin verwendet.
# Auf geschützten Vercel-Preview-Deployments ist das Setzen wichtig: der Origin
# zeigt dort auf eine URL, die nach dem Google-Login "You Need Access" erzwingt.
VITE_PUBLIC_URL=https://app.baitbuddy.example
