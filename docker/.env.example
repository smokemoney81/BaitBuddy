# BaitBuddy Self-Hosting — Konfiguration für docker compose
#
# Einrichtung (siehe docs/DOCKER_SELFHOST.md):
#   cp .env.example .env
#   node scripts/generate-keys.mjs
#
# generate-keys.mjs füllt die unten leer gelassenen Geheimnisse. Es ersetzt
# genau die Zeilen "SCHLUESSEL=" — diese also nicht umbenennen und nicht
# auskommentieren, sonst hängt das Skript die Werte doppelt an.
#
# Jede Variable hier wird von docker-compose.yml gelesen. Fehlt eine, startet
# der Stack mit leerem Wert statt mit einem Default.

# ─── Von generate-keys.mjs erzeugt — leer lassen ──────────────────────────────

POSTGRES_PASSWORD=
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=
CRON_SECRET=
DASHBOARD_PASSWORD=

# ─── Ports auf dem Host ───────────────────────────────────────────────────────

# Postgres, nur für direkten psql-Zugriff und die Dump-Skripte.
POSTGRES_PORT=5432
# Kong = das Supabase-API-Gateway. Das ist die SUPABASE_URL für App und Backend.
KONG_HTTP_PORT=8000
# Express-Backend (Health-Check: http://localhost:3000/api/health).
BACKEND_PORT=3000
# Nginx mit der gebauten Web-App.
FRONTEND_PORT=8080

# ─── Adressen ─────────────────────────────────────────────────────────────────

# Kong von außen: Auth-Redirects und Storage-URLs werden damit gebildet, und
# der Vite-Build brennt den Wert als VITE_SUPABASE_URL ein. Nach einer Änderung
# das Frontend neu bauen: docker compose up -d --build frontend
API_EXTERNAL_URL=http://localhost:8000
# Die Web-App von außen.
SITE_URL=http://localhost:8080
# CORS-Allowlist des Backends, kommagetrennt. capacitor://localhost bleibt
# drin, sonst sperrt der WebView der gepackten Android-App sich selbst aus.
ALLOWED_ORIGINS=http://localhost:8080,capacitor://localhost
# Erlaubte Rücksprungziele nach Login/Passwort-Reset (GoTrue URI-Allowlist).
ADDITIONAL_REDIRECT_URLS=http://localhost:8080/*,capacitor://localhost/*

# Für LAN- oder Internet-Betrieb siehe Abschnitt 6 in docs/DOCKER_SELFHOST.md:
# Alle vier Werte auf die echten Domains setzen, TLS davorschalten, und in
# capacitor.config.json sowie AndroidManifest.xml die neue SITE_URL eintragen.

# ─── Anmeldung ────────────────────────────────────────────────────────────────

# Gültigkeit der Zugangstokens in Sekunden (3600 = 1 Stunde).
JWT_EXPIRY=3600
# true sperrt Neuregistrierungen komplett.
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
# true bestätigt neue Konten sofort — nötig, solange kein SMTP eingerichtet ist,
# sonst wartet jede Registrierung auf eine Mail, die niemand verschickt.
ENABLE_EMAIL_AUTOCONFIRM=true

# Google-Login. Redirect-URI in der Google-Cloud-Console:
# <API_EXTERNAL_URL>/auth/v1/callback
GOOGLE_OAUTH_ENABLED=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_SECRET=

# Supabase Studio (Datenbank-Oberfläche über Kong).
DASHBOARD_USERNAME=admin

# ─── KI-Buddy ─────────────────────────────────────────────────────────────────

# Pflicht — ohne diesen Schlüssel antwortet der Buddy nicht.
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
# Default claude-haiku-4-5 (hält das Latenzziel < 2 s). Leer lassen für Default.
ANTHROPIC_MODEL=

# ─── Sprachausgabe ────────────────────────────────────────────────────────────

# Provider-Reihenfolge: OPENAI_API_KEY → ELEVENLABS_API_KEY → … Der erste
# gesetzte Schlüssel gewinnt. Wer die ElevenLabs-Stimme will, lässt
# OPENAI_API_KEY leer (siehe CLAUDE.md).
ELEVENLABS_API_KEY=
# Männlich "Daniel" (alle Pläne), weiblich "Matilda" (nur Ultimate).
ELEVENLABS_VOICE_ID=onwK4e9ZLuTAKqWW03F9
ELEVENLABS_VOICE_ID_FEMALE=XrExE9yKIg1WjnnlVkGX
# Auch für die Realtime-Voice-Session (POST /api/ai/realtime-session).
OPENAI_API_KEY=

# ─── Kaufverifikation ─────────────────────────────────────────────────────────

# Ohne diese Werte antwortet /premium/activate mit 501, statt einen Plan
# ungeprüft freizuschalten.
STRIPE_SECRET_KEY=
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=

# ─── Administration ───────────────────────────────────────────────────────────

# Kommagetrennte Allowlist für Admin-Endpunkte.
ADMIN_EMAILS=admin@baitbuddy.example

# ─── E-Mail ───────────────────────────────────────────────────────────────────

# GoTrue verschickt damit Bestätigungs- und Reset-Mails. Ohne SMTP bleibt
# ENABLE_EMAIL_AUTOCONFIRM=true nötig.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_ADMIN_EMAIL=
SMTP_SENDER_NAME=BaitBuddy

# Empfänger der Support-Ticket-Benachrichtigung (backend/src/routes/support.js).
DEVELOPER_EMAIL=

# ─── Betrieb ──────────────────────────────────────────────────────────────────

# Redis als instanzübergreifender Rate-Limit-Zähler. Der Dienst startet nur mit
# dem Profil: docker compose --profile redis up -d
# Ohne Wert nutzt das Backend seinen In-Memory-Zähler — für einen einzelnen
# Container völlig ausreichend.
KV_URL=

# DEBUG | INFO | WARN | ERROR | CRITICAL. Leer = INFO in Produktion.
LOG_LEVEL=
# Sentry greift nur mit DSN und NODE_ENV=production.
SENTRY_DSN=
